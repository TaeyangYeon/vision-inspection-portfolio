<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InspectionSystem.UI.ViewModels"
             x:Class="InspectionSystem.UI.Views.GradCamView"
             x:DataType="vm:GradCamViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open Image"
                        Command="{Binding OpenImageCommand}"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        Padding="12,6"/>
                <Button Content="Generate GradCAM"
                        Command="{Binding GenerateGradCamCommand}"
                        IsEnabled="{Binding IsGenerating, Converter={x:Static BoolConverters.Not}}"
                        Background="#0078D4"
                        Foreground="White"
                        Padding="12,6"/>

                <Separator Width="1" Background="#313244" Margin="4,0"/>

                <!-- Target Class -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Target Class:"
                               Foreground="#BAC2DE"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding TargetClass}"
                                   Minimum="0"
                                   Maximum="10"
                                   Width="80"
                                   FormatString="0"/>
                </StackPanel>

                <!-- Alpha Slider -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Opacity:"
                               Foreground="#BAC2DE"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Slider Value="{Binding Alpha}"
                            Minimum="0.1"
                            Maximum="0.9"
                            Width="100"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Alpha, StringFormat={}{0:F2}}"
                               Foreground="#CDD6F4"
                               FontSize="12"
                               Width="32"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Width="1" Background="#313244" Margin="4,0"/>

                <!-- API Status -->
                <Border Background="{Binding IsApiAvailable,
                            Converter={StaticResource BoolToBrushConverter},
                            ConverterParameter='#A6E3A1|#F38BA8'}"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApiStatus}"
                               Foreground="White"
                               FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Content - 3 column split view -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*">

            <!-- Original -->
            <Border Grid.Column="0"
                    Background="#11111B"
                    BorderBrush="#313244"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="ORIGINAL"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#6C7086"
                               LetterSpacing="2"
                               Margin="12,8"/>
                    <Image Grid.Row="1"
                           Source="{Binding OriginalImage}"
                           Stretch="Uniform"
                           Margin="8"/>
                    <TextBlock Grid.Row="1"
                               Text="Open an image"
                               Foreground="#45475A"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding OriginalImage,
                                   Converter={x:Static ObjectConverters.IsNull}}"/>
                </Grid>
            </Border>

            <!-- Heatmap -->
            <Border Grid.Column="1"
                    Background="#11111B"
                    BorderBrush="#313244"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="GRADCAM HEATMAP"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#6C7086"
                               LetterSpacing="2"
                               Margin="12,8"/>
                    <Image Grid.Row="1"
                           Source="{Binding HeatmapImage}"
                           Stretch="Uniform"
                           Margin="8"/>
                    <TextBlock Grid.Row="1"
                               Text="Generate GradCAM to see heatmap"
                               Foreground="#45475A"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HeatmapImage,
                                   Converter={x:Static ObjectConverters.IsNull}}"/>
                </Grid>
            </Border>

            <!-- Overlay -->
            <Border Grid.Column="2"
                    Background="#11111B">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0"
                               Text="OVERLAY"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#6C7086"
                               LetterSpacing="2"
                               Margin="12,8"/>
                    <Image Grid.Row="1"
                           Source="{Binding OverlayImage}"
                           Stretch="Uniform"
                           Margin="8"/>
                    <TextBlock Grid.Row="1"
                               Text="Overlay will appear here"
                               Foreground="#45475A"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding OverlayImage,
                                   Converter={x:Static ObjectConverters.IsNull}}"/>

                    <!-- CAM Stats -->
                    <Border Grid.Row="2"
                            Background="#181825"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="CAM Mean"
                                       Foreground="#6C7086"
                                       FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CamMean, StringFormat={}{0:F4}}"
                                       Foreground="#CDD6F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="CAM Max"
                                       Foreground="#6C7086"
                                       FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding CamMax, StringFormat={}{0:F4}}"
                                       Foreground="#CDD6F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#11111B"
                BorderBrush="#313244"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#6C7086"
                       FontSize="11"/>
        </Border>

    </Grid>
</UserControl>