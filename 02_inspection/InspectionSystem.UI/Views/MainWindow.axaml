<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InspectionSystem.UI.ViewModels"
        x:Class="InspectionSystem.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding AppTitle}"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#1E1E2E">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="#181825"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding AppTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#CDD6F4"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="#F38BA8"/>
                        <TextBlock Text="{Binding ModelStatus}"
                                   FontSize="12"
                                   Foreground="#BAC2DE"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">

            <!-- Left Navigation -->
            <Border Grid.Column="0"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">

                    <TextBlock Text="NAVIGATION"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#6C7086"
                               Margin="16,0,0,8"
                               LetterSpacing="2"/>

                    <ListBox ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage}"
                             Background="Transparent"
                             Margin="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Padding="8,10"
                                           FontSize="14"
                                           Foreground="#CDD6F4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#313244"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#25253A"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- Spacer -->
                    <Border Height="1"
                            Background="#313244"
                            Margin="16,16"/>

                    <!-- Session Stats -->
                    <TextBlock Text="SESSION STATS"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#6C7086"
                               Margin="16,0,0,8"
                               LetterSpacing="2"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          Margin="16,0"
                          RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{Binding SessionStats.TotalInspected}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#CDD6F4"/>
                            <TextBlock Text="Total"
                                       FontSize="11"
                                       Foreground="#6C7086"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{Binding SessionStats.NgCount}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F38BA8"/>
                            <TextBlock Text="NG"
                                       FontSize="11"
                                       Foreground="#6C7086"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{Binding SessionStats.OkCount}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#A6E3A1"/>
                            <TextBlock Text="OK"
                                       FontSize="11"
                                       Foreground="#6C7086"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="{Binding SessionStats.NgRate, StringFormat={}{0:F1}%}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#FAB387"/>
                            <TextBlock Text="NG Rate"
                                       FontSize="11"
                                       Foreground="#6C7086"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Clear Session"
                            Command="{Binding ClearSessionCommand}"
                            Margin="16,16,16,0"
                            HorizontalAlignment="Stretch"
                            Background="#313244"
                            Foreground="#CDD6F4"
                            Padding="8,6"/>

                </StackPanel>
            </Border>

            <!-- Page Content -->
            <Border Grid.Column="1"
                    Background="#1E1E2E">
                <ContentControl Content="{Binding CurrentPageView}"/>
            </Border>

        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Vision Inspection System v1.0"
                           FontSize="11"
                           Foreground="#6C7086"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SessionStats.AverageInferenceMs, StringFormat='Avg: {0:F1}ms'}"
                           FontSize="11"
                           Foreground="#6C7086"
                           Margin="16,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SessionStats.EstimatedFps, StringFormat='FPS: {0:F1}'}"
                           FontSize="11"
                           Foreground="#6C7086"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="ONNX Runtime"
                           FontSize="11"
                           Foreground="#6C7086"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
